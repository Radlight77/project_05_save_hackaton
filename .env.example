# Модель для локального запуска
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen3-vl:30b-a3b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Для MODEL_PROVIDER=openai укажите имя доступной модели и собственный ключ.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Для MODEL_PROVIDER=hf укажите модель и токен своего провайдера.
HF_MODEL=openai/gpt-oss-120b
HF_TOKEN=
# HF_BASE_URL=https://router.huggingface.co/v1

# Оценочные ставки платного API в USD за миллион токенов.
# Перед платным запуском подставьте тариф своей модели.
INPUT_USD_PER_MILLION=10
OUTPUT_USD_PER_MILLION=60
